@page
@model WebApp.Pages.IndexModel
@{
    Layout = "_LayoutFormPage";
    ViewData["Forms"] = "Login";
}

<div class="log-in">
    <form method="post">
        <div class="group">
            <label asp-for="LoginUser.Email">Email: </label>
            <span asp-validation-for="LoginUser.Email" style="color:red"></span>
            <br />
            <input asp-for="LoginUser.Email" />
            <br />
        </div>
        <div class="group">
            <label asp-for="LoginUser.Password">Password: </label>
            <span asp-validation-for="LoginUser.Password" style="color:red"></span>
            <br />
            <input asp-for="LoginUser.Password" type="password" />
            <br />
        </div>
        <div class="group">
            <input type="checkbox" class="check">
            <label for="check"><span class="icon"></span> Keep me Logged in</label>
        </div>
        <div class="group">
            <input type="submit" class="button" value="Log In">
        </div>
    </form>
    <div class="hr"></div>
    <div class="foot-lnk">
        <a class="forgot-link" href="#forgot">Forgot Password?</a>
        <a class="register" asp-area="" asp-page="/Register">Not a Member Yet?</a>
    </div>
</div>

@* remove id for it to work most prob *@
@section Scripts 
{
    <partial name ="_ValidationScriptsPartial" />
}