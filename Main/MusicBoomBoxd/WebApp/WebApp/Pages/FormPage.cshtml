@page
@model FormPageModel
@{
	ViewData["Title"] = "Form Page";
}

<link rel="stylesheet" href="~/css/formpagealbum.css" />

<div class="container">
	<h2 class="h2">Add New Album!</h2>
	<h3 class="text-danger">@Html.Raw(ViewData["ErrorMessage"])</h3>
	<div class="centered-container">
		<form method="post" class="form" enctype="multipart/form-data" onsubmit="gatherSelectedSongs()">

			<div class="form-group">
				<label asp-for="AlbumCover" class="form-group">Album Cover:<sup>*</sup></label>
				<input type="file" asp-for="AlbumCover" class="form-control">
				<span asp-validation-for="AlbumCover" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label for="title" class="label" asp-for="InputAlbum.Title">Title:<sup>*</sup></label>
				<span asp-validation-for="InputAlbum.Title" class="text-danger"></span>
				<input id="title" type="text" class="input" asp-for="InputAlbum.Title">
			</div>

			<div class="form-group">
				<label asp-for="InputAlbum.Artist.ArtistID">Artist:<sup>*</sup></label>
				<select asp-for="InputAlbum.Artist.ArtistID" class="form-control">
					<option value="">Select an Artist</option>
					@foreach (var artist in Model.Artists)
					{
						<option value="@artist.ArtistID">@artist.Name</option>
					}
				</select>
				<span asp-validation-for="InputAlbum.Artist.ArtistID" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label for="runtime" class="label" asp-for="InputAlbum.RunTime">Runtime:<sup>*</sup></label>
				<span asp-validation-for="InputAlbum.RunTime" class="text-danger"></span>
				<input id="runtime" type="number" class="input" asp-for="InputAlbum.RunTime">
			</div>

			<div class="form-group">
				<label for="date" class="date" asp-for="InputAlbum.Date">Date:<sup>*</sup></label>
				<input asp-for="InputAlbum.Date" class="form-control" type="date">
				<span asp-validation-for="InputAlbum.Date" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="InputAlbum.Genre">Genre:<sup>*</sup></label>
				<select asp-for="InputAlbum.Genre" class="form-control">
					<option value="">Select a Genre</option>
					@foreach (var genre in Model.GenreOptions)
					{
						<option value="@genre.Value">@genre.Text</option>
					}
				</select>
				<span asp-validation-for="InputAlbum.Genre" class="text-danger"></span>
			</div>

			<input type="hidden" asp-for="SelectedSongIDs" id="SelectedSongIDs" />
			
			<div class="form-group">
				<table class="song-table">
					<thead>
						<tr>
							<th>Song Title</th>
							<th>Artist</th>
							<th>Genre</th>
							<th>Duration(Sec)</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var song in Model.Songs)
						{
							<tr class="song-row">
								<td>@song.Title</td>
								<td>@song.ArtistName</td>
								<td>@song.Genre</td>
								<td>@song.RunTime</td>
								<td>
									<div class="CheckBox">
										<input id="check-@song.SongID" type="checkbox" class="check" value="@song.SongID">
										<label for="check-@song.SongID"><span class="icon"></span></label>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="button-container">
				<button type="submit" class="button">Save</button>
				<button type="button" class="button-secondary" onclick="location.href='@Url.Page("/HomePage")'">Cancel</button>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		function gatherSelectedSongs() {
			var selectedSongs = [];
			document.querySelectorAll('.check:checked').forEach(function (checkbox) {
				selectedSongs.push(checkbox.value);
			});
			document.getElementById('SelectedSongIDs').value = selectedSongs.join(',');
		}
	</script>
}