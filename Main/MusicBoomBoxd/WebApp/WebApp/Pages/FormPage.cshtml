@page
@model FormPageModel
@{
	Layout = "_LayoutFormPage";
	ViewData["Forms"] = "Form Page";
}

<div class="container">
	<h2 class="h2">Add New Album!</h2>
	<div class="centered-container">
		<form method="post" class="form" enctype="multipart/form-data">

			<div class="form-group">
				<label asp-for="Input.AlbumCover">Album Cover:<sup>*</sup></label>
				<input asp-for="Input.AlbumCover" class="form-control-file">
				<span asp-validation-for="Input.AlbumCover" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Input.Title">Title:<sup>*</sup></label>
				<input asp-for="Input.Title" class="form-control">
				<span asp-validation-for="Input.Title" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label for="artist" asp-for="Input.Artist">Artist:<sup>*</sup></label>
				<input asp-for="Input.Artist" class="form-control">
				<span asp-validation-for="Input.Artist" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Input.Date">Date:<sup>*</sup></label>
				<input asp-for="Input.Date" class="form-control" type="date">
				<span asp-validation-for="Input.Date" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="Input.Genre">Genre:<sup>*</sup></label>
				<input asp-for="Input.Genre" class="form-control">
				<span asp-validation-for="Input.Genre" class="text-danger"></span>
			</div>

			<table class="song-table">
				<thead>
					<tr>
						<th>SongTitle</th>
						<th>Genre</th>
						<th>Duration(Sec)</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var song in Model.Songs)
					{
						<tr class="song-row">
							<td>@song.Title</td>
							<td>@song.Genre</td>
							<td>@song.RunTime</td>
							<td> 
								<div class="CheckBox">
									<input id="check" type="checkbox" class="check">
									<label for="check"><span class="icon"></span> </label>
								</div> 
							</td>
						</tr>
					}
				</tbody>
			</table>

			<div class="button-container">
				<button type="submit" class="btn btn-primary">Save</button>
				<button type="reset" class="btn btn-secondary">Cancel</button>
			</div>
		</form>
	</div>
</div>
