@page
@using Infrastructure
@model WebApp.Pages.ProfileModel
@{
    Layout = "_LayoutFormPage";
    ViewData["Forms"] = "Register";
}

<link rel="stylesheet" href="~/css/profile.css" />

<h2>Profile Information</h2>

<p><strong>Username:</strong> @Model.Profile.Username</p>
<p><strong>Email:</strong> @Model.Profile.Email</p>
<p><strong>Bio:</strong> @Model.Profile.Bio</p>

<a asp-page="/EditProfile" class="btn btn-primary">Edit Profile Info</a>