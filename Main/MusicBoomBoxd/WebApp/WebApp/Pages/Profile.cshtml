@page
@model WebApp.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/profile.css" />

<main>
    <div class="profile-page-container">
        <div class="profile-container">
            <div class="profile-header">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="profile-details">
                @if (Model.ProfilePictureData != null && Model.ProfilePictureData.Length > 0)
                {
                    string base64Image = Convert.ToBase64String(Model.ProfilePictureData);
                    string imageSrc = $"data:{Model.ProfilePictureContentType};base64,{base64Image}";
                    <img src="@imageSrc" alt="Profile Picture" class="pfp" />
                }
                else
                {
                    <img src="Images/MONKE.jpg" alt="Could not load image" class="pfp" />
                }
                <p><strong>Username:</strong> @Model.Username</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Role:</strong> @Model.Role</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }
            </div>
            <div class="profile-actions">
                <form method="post">
                    <div>
                        <label for="Username">Username:</label>
                        <input type="text" class="lbl" id="Username" name="Username" value="@Model.Username" required />
                    </div>
                    <div>
                        <label for="Email">Email:</label>
                        <input type="email" class="lbl" id="Email" name="Email" value="@Model.Email" required />
                    </div>
                    <div>
                        <label for="ProfilePicture">Profile Picture:</label>
                        <input type="file" id="ProfilePicture" name="ProfilePicture" class="profile-control" />
                    </div>
                    <button type="submit" class="update" asp-page-handler="UpdateProfile">Update Profile</button>
                </form>

                <form method="post">
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Regular"))
                    {
                        <button type="submit" class="upgrade" asp-page-handler="UpgradeAccount">Upgrade Your Account</button>
                    }

                    <button type="submit" class="deactivate" asp-page-handler="DeleteAccount">Deactivate Your Account</button>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
