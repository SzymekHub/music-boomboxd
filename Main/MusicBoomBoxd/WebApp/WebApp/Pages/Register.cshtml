@page
@model RegisterModel
@{
    Layout = "_LayoutFormPage";
    ViewData["Forms"] = "Register";
}

<div class="container">
    <h2 class="h2">Welcome new User!</h2>
    <div class="centered-container">
        <form method="post" class="form" enctype="multipart/form-data">

            <div class="form-group">
                <label asp-for="ProfilePicture" class="form-group"></label>
                <input type="file" asp-for="ProfilePicture" class="form-control" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="RegiUser.ProfilePictureName" />
            <input type="hidden" asp-for="RegiUser.ProfilePictureContentType" />

            <div class="form-group">
                <label for="user" class="label" asp-for="RegiUser.Name">Username</label>
                <span asp-validation-for="RegiUser.Name" class="text-danger"></span>
                <input id="user" type="text" class="input" asp-for="RegiUser.Name" />
            </div>

            <div class="form-group">
                <label for="pass" class="label" asp-for="RegiUser.Password">Password</label>
                <span asp-validation-for="RegiUser.Password" class="text-danger"></span>
                <input id="pass" type="password" class="input" asp-for="RegiUser.Password" />
            </div>

            <div class="form-group">
                <label for="pass" class="label" asp-for="RegiUser.Email">Email</label>
                <span asp-validation-for="RegiUser.Email" class="text-danger"></span>
                <input id="email" type="text" class="input" asp-for="RegiUser.Email" />
            </div>

            <div class="form-group">
                <label for="userType" class="label" asp-for="RegiUser.UserType">User Type</label>
                <select id="userType" class="input" asp-for="RegiUser.UserType">
                    <option value="Regular">Regular</option>
                    <option value="Critic">Critic</option>
                    <option value="Musician">Musician</option>
                </select>
            </div>

            <div class="form-group">
                <label for="birthday" class="label" asp-for="RegiUser.Birthday">Birthday</label>
                <span asp-validation-for="RegiUser.Birthday" class="text-danger"></span>
                <input id="birthday" type="date" class="input" asp-for="RegiUser.Birthday" />
            </div>

            <div class="form-group">
                <label for="genre" class="label" asp-for="RegiUser.FavGenre">Favorite Genre</label>
                <select class="input" asp-for="RegiUser.FavGenre">
                    <option value="Rock">Rock</option>
                    <option value="Reggae">Reggae</option>
                    <option value="Metal">Metal</option>
                    <option value="Rap">Rap</option>
                    <option value="Blues">Blues</option>
                    <option value="HipHop">HipHop</option>
                    <option value="Pop">Pop</option>
                    <option value="ClassicalMusic">ClassicalMusic</option>
                    <option value="Disco">Disco</option>
                    <option value="Folk">Folk</option>
                    <option value="Country">Country</option>
                    <option value="Techno">Techno</option>
                </select>
            </div>

            <div class="button-container">
                <button type="submit" class="btn btn-primary">Register</button>
            </div>
        </form>
        <div class="foot-lnk">
            <a class="login" asp-area="" asp-page="/Index">Already a Member?</a>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
