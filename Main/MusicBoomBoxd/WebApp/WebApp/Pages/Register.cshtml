@page
@model RegisterModel
@{
    Layout = "_LayoutFormPage";
    ViewData["Forms"] = "Register";
}

<div class="container">
    <h2 class="h2">Welcome new User!</h2>
    <div class="centered-container">
        <form method="post" class="form" enctype="multipart/form-data">

            <div class="form-group">
                <label asp-for="ProfilePicture" class="form-group">ProfilePicture:<sup>*</sup></label>
                <input type="file" asp-for="ProfilePicture" class="form-control" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="RegiUser.ProfilePictureName" />
            <input type="hidden" asp-for="RegiUser.ProfilePictureContentType" />

            <div class="form-group">
                <label for="user" class="label" asp-for="RegiUser.Name">Username:<sup>*</sup></label>
                <span asp-validation-for="RegiUser.Name" class="text-danger"></span>
                <input id="user" type="text" class="input" asp-for="RegiUser.Name" />
            </div>

            <div class="form-group">
                <label for="pass" class="label" asp-for="RegiUser.Password">Password:<sup>*</sup></label>
                <span asp-validation-for="RegiUser.Password" class="text-danger"></span>
                <input id="pass" type="password" class="input" asp-for="RegiUser.Password" />
            </div>

            <div class="form-group">
                <label for="pass" class="label" asp-for="RegiUser.Email">Email:<sup>*</sup></label>
                <span asp-validation-for="RegiUser.Email" class="text-danger"></span>
                <input id="email" type="text" class="input" asp-for="RegiUser.Email" />
            </div>

            <div class="form-group">
                <label asp-for="RegiUser.UserType">UserType:<sup>*</sup></label>
                <select asp-for="RegiUser.UserType" class="form-control">
                    <option value="">Select a User Type</option>
                    @foreach (var userType in Model.UserOptions)
                    {
                        <option value="@userType.Value">@userType.Text</option>
                    }
                </select>
                <span asp-validation-for="RegiUser.UserType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="birthday" class="label" asp-for="RegiUser.Birthday">Birthday:<sup>*</sup></label>
                <span asp-validation-for="RegiUser.Birthday" class="text-danger"></span>
                <input id="birthday" type="date" class="input" asp-for="RegiUser.Birthday" />
            </div>

            <div class="form-group">
                <label asp-for="RegiUser.FavGenre">Genre:<sup>*</sup></label>
                <select asp-for="RegiUser.FavGenre" class="form-control">
                    <option value="">Select a Genre</option>
                    @foreach (var genre in Model.GenreOptions)
                    {
                        <option value="@genre.Value">@genre.Text</option>
                    }
                </select>
                <span asp-validation-for="RegiUser.FavGenre" class="text-danger"></span>
            </div>

            <div class="button-container">
                <button type="submit" class="btn btn-primary">Register</button>
            </div>
        </form>
        <div class="foot-lnk">
            <a class="login" asp-area="" asp-page="/Index">Already a Member?</a>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
