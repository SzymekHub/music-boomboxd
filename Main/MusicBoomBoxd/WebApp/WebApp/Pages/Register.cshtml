@page
@model WebApp.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/FormPageStyle.css" />

<div class="register">
    <form method="post">
        <div class="group">
            <label for="user" class="label">Username</label>
            <input id="user" type="text" class="input" asp-for="Input.UserName">
        </div>
        <div class="group">
            <label for="pass" class="label">Password</label>
            <input id="pass" type="password" class="input" asp-for="Input.Password">
        </div>
        <div class="group">
            <label for="pass" class="label">Email</label>
            <input id="pass" type="text" class="input" asp-for="Input.Email">
        </div>
        <div class="group">
            <button type="submit" class="button">Register</button>
        </div>
    </form>
        <a class="login" asp-area="" asp-page="/Index">Already a Member?</a>
</div>