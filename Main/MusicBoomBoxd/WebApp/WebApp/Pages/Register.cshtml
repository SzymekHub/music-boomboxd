@page
@using Infrastructure
@model WebApp.Pages.RegisterModel
@{
    Layout = "_LayoutFormPage";
    ViewData["Forms"] = "Register";
}

<div class="register">
<h2 class="h2"> Welcome new User!</h2>
<div class="centered-container">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            
            <div class="form-group">
                <label asp-for="User.ProfilePictureName"></label>
                <input asp-for="User.ProfilePictureName" type="file" class="form-control" />
                <span asp-validation-for="User.ProfilePictureName" class="text-danger"></span>
            </div>
            <div class="form-group">
            <label for="user" class="label" asp-for="User.UserName">Username</label>
            <span asp-validation-for="User.UserName" style="color:red"></span>
            <input id="user" type="text" class="input" asp-for="User.UserName">
        </div>
        <div class="form-group">
            <label for="pass" class="label" asp-for="User.Password">Password</label>
            <span asp-validation-for="User.Password" style="color:red"></span>
            <input id="pass" type="password" class="input" asp-for="User.Password">
        </div>
        <div class="form-group">
            <label for="pass" class="label" asp-for="User.Email">Email</label>
            <span asp-validation-for="User.Email" style="color:red"></span>
            <input id="pass" type="text" class="input" asp-for="User.Email">
        </div>

        <div class="form-group">
            <label for="userType" class="label" asp-for="User.UserType">User Type</label>
            <select id="userType" class="input" asp-for="User.UserType">
                <option value="Regular">Regular</option>
                <option value="Critic">Critic</option>
                <option value="Musician">Musician</option>
            </select>
        </div>

        <div class="form-group">
            <label for="birthday" class="label" asp-for="User.Birthday">Birthday</label>
            <input id="birthday" type="date" class="input" asp-for="User.Birthday">
        </div>

        <div class="form-group">
            <label for="genre" class="label" asp-for="User.FavGenre">Favorite Genre</label>
            <select id="genre" class="input" asp-for="User.FavGenre">
                <option value="Rock">Rock</option>
                <option value="Reggae">Reggae</option>
                <option value="Metal">Metal</option>
                <option value="Rap">Rap</option>
                <option value="Blues">Blues</option>
                <option value="HipHop">HipHop</option>
                <option value="Pop">Pop</option>
                <option value="ClassicalMusic">ClassicalMusic</option>
                <option value="Disco">Disco</option>
                <option value="Folk">Folk</option>
                <option value="Country">Country</option>
                <option value="Techno">Techno</option>
            </select>
        </div>

            <div class="button-container">
                <button type="submit" class="button" value="Register">Register</button>
            </div>
        </form>
    <a class="login" asp-area="" asp-page="/Index">Already a Member?</a>
</div>

@section Scripts
{
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
