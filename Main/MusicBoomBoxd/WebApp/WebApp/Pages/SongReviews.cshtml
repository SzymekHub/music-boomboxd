@page
@model WebApp.Pages.SongReviewsModel
@{
	ViewData["Title"] = "Song Reviews page";
	int songCount = 0;

}

<link rel="stylesheet" href="~/css/homepage.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="container">
	<div class="New-Music-Content">
		<h2>SONGS</h2>
		<section id="New-Music-Coming" class="New-Albums-Grid">
			@foreach (var song in Model.Songs)
			{
				<article class="New-Albums">
					<img src="data:@song.SongCoverContentType;base64,@song.SongCoverData" alt="@song.Title" class="albums">
					<div class="Album-Name">
						<p>@song.Title</p>
					</div>
					<div class="Album-info">
						<p>By: @song.Artist</p>
						<p>Genre: @song.Genre</p>
						<p>Released: @song.Date.ToString("dd/MM/yyyy")</p>
											</div>
					<div class="star-rating" data-rating="@song.AverageRating">
						<i class="fa fa-star"></i>
						<i class="fa fa-star"></i>
						<i class="fa fa-star"></i>
						<i class="fa fa-star"></i>
						<i class="fa fa-star"></i>
					</div>
				</article>
			}
		</section>
	</div>
</div>

<script>
	function fillStars() {
		document.querySelectorAll('.star-rating').forEach(function (ratingElem) {
			var rating = parseFloat(ratingElem.getAttribute('data-rating'));
			var stars = ratingElem.querySelectorAll('.fa-star');
			for (var i = 0; i < stars.length; i++) {
				if (i < rating) {
					stars[i].classList.add('checked');
				}
			}
		});
	}

	window.onload = function () {
		fillStars();
	};
</script>
