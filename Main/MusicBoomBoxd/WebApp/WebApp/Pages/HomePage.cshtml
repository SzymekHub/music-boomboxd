@page
@model HomePageModel
@{
	ViewData["Title"] = "Home page";
	int songCount = 0;

}

<link rel="stylesheet" href="~/css/homepage.css" />

<div class="container">
	<div class="New-Music-Content">
		<h2>ALBUMS</h2>
		<section id="New-Music-Coming" class="New-Albums-Grid">
			@foreach (var album in Model.Albums)
			{
				<article class="New-Albums">
					<img src="data:@album.AlbumCoverContentType;base64,@album.AlbumCoverData" alt="@album.Title" class="albums">
					<div class="Album-Name">
						<p>@album.Title</p>
					</div>
					<div class="Album-info">
						<p>By: @album.Artist</p>
						<p>Genre: @album.Genre</p>
						<p>Released: @album.Date.ToString("dd/MM/yyyy")</p>
						<p>
							Songs:
							<ol>
								@foreach (var song in album.Songs)
								{
									if (songCount <= 3)
									{
										<li>@song.Title</li>
										songCount++;
									}
									else
									{
										break;
									}
								}
							</ol>

							@if (album.Songs.Count > 3)
							{
							<p>Etc...</p>
							}
						</p>
					</div>
				</article>
			}
		</section>
	</div>
</div>
