@* @page
@model UserBalanceModel
@{
	Layout = "_Layout";
	ViewData["Forms"] = "Register";
}

<div class="User-balance-page-container">
	<div class="recommendation-box left-recommendation">
		<p>*Recommendations*</p>
	</div>
	<div class="balance-container">
		<div class="balance-header">
			<h1>@ViewData["Title"]</h1>
		</div>
		<p class="balance"> Balance: $@Model.Balance.ToString("0.00")</p>
		<form method="post">
			<div class="input-group">
				<label for="amount">Amount to Add:</label>
				<input type="number" id="amount" name="amount" step="0.01" required />
			</div>
			<button type="submit">Add to Balance</button>
		</form>
	</div>
	<div class="recommendation-box right-recommendation">
		<p>*Recommendations*</p>
	</div>
</div>

@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
}
 *@