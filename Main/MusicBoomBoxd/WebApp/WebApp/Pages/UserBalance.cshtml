@page
@model UserBalanceModel
@{
	ViewData["Title"] = "My Balanace";
}

<link rel="stylesheet" href="~/css/userbalance.css" />
<main>
	<div class="User-balance-page-container">
		<div class="balance-container">
			<div class="User-balance-header">
				<h1>@ViewData["Title"]</h1>
			</div>
			<p class="userbalance"> User Balance: $@Model.UserBalance.ToString("0.00")</p>
			<form method="post">
				<div class="input-group">
					<label for="amount">Amount to Add:</label>
					<input type="number" id="amount" name="amount" step="0.01" required />
				</div>
				<button type="submit">Add to User Balance</button>
			</form>
		</div>
	</div>
</main>
@section Scripts
{
	<partial name="_ValidationScriptsPartial" />
}
