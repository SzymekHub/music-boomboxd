@page
@model FormPageModel
@{
    ViewData["Title"] = "Form Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Music</title>
    <link rel="stylesheet" href="/css/FormPageStyle.css">

</head>
<body>
    <h2 style="text-align: center;">Add New Music</h2>
    <div class="logo-container">
        <img src='Images/LogoBlue.png' alt="Logo" class="logo">
    </div>
    <form id="newMusicForm">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title">

        <label for="artist">Artist:</label>
        <input type="text" id="artist" name="artist">

        <label for="date">Date:</label>
        <input type="date" id="date" name="date">

        <label for="genre">Genre:</label>
        <input type="text" id="genre" name="genre">

        <button type="submit">Add Music</button>
        <ul class="left-links">
            <li><a href="Index">Homepage</a></li>
        </ul>
    </form>
</body>
</html>